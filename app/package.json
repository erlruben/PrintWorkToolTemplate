{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --mode demo",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:api": "node tests/api.mjs",
    "test:roles": "node tests/roles.mjs",
    "test:ui": "node tests/ui/run.mjs ui-shots --roles --sizes=desktop,tablet,phone,small",
    "test:memory": "node tests/ui/memory.mjs 30",
    "test:scrolled": "node tests/ui/scrolled.mjs ui-shots/scrolled"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "pg": "^8.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.12"
  }
}
