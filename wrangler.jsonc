// Cloudflare Workers hosting (static assets only — no server code).
// Deploy the sample-only demo to its own development Worker, never the source
// tracker's hosting. Security headers: app/public/_headers.
{
  "name": "printworktooltemplate-dev",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./app/dist",
    // One page app: any unknown path serves index.html.
    "not_found_handling": "single-page-application"
  }
}
