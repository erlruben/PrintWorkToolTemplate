// Cloudflare Workers hosting (static assets only — no server code).
// Workers Builds runs from the repo root: `npm run build` (builds app/), then
// `npx wrangler deploy` uploads app/dist. Security headers: app/public/_headers.
{
  "name": "printtemplate",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./app/dist",
    // One page app: any unknown path serves index.html.
    "not_found_handling": "single-page-application"
  }
}
